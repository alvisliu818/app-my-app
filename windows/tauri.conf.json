{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinLayout",
  "version": "0.1.0",
  "identifier": "com.alvisliu.winlayout",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WinLayout · 窗口布局管家",
        "width": 1220,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
